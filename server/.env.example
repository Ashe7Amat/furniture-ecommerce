# server/.env.example

# Puerto del servidor local (por defecto 5000)
PORT=5000

# URL del proyecto de Supabase (ej: https://xxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de servicio de Supabase o Anon Key (Anon Key suele bastar para inserciones básicas si no hay RLS estrictas)
SUPABASE_ANON_KEY=tu-clave-de-supabase

# Secreto para firmar los tokens de sesión (login/admin). Genera uno único por entorno, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# URL pública del frontend, se usa para volver desde el pago de Stripe
CLIENT_URL=http://localhost:5173

# Clave secreta de Stripe en modo TEST (Dashboard de Stripe > Desarrolladores > Claves de API). Empieza por sk_test_...
STRIPE_SECRET_KEY=

# Todos los correos (bienvenida, aviso de venta, confirmación al cliente) se envían con
# Resend (https://resend.com)
# 1) Crea una cuenta en Resend y genera una API key en el Dashboard > API Keys.
# 2) RESEND_API_KEY: la clave generada (empieza por "re_..."). Si se deja en blanco,
#    el sistema simula el envío con logs en consola en vez de fallar.
RESEND_API_KEY=

# Dirección remitente. Con el plan gratuito de Resend, sin un dominio propio verificado,
# SOLO puedes usar el dominio sandbox "onboarding@resend.dev" -- y ese dominio únicamente
# entrega correos a la dirección con la que verificaste tu cuenta de Resend. Si más adelante
# verificas un dominio propio (Dashboard > Domains), cambia esto por algo como
# "Nave 5 Barcelona <ventas@nave5barcelona.com>".
RESEND_FROM=Nave 5 Barcelona <onboarding@resend.dev>

# Email donde el administrador recibirá las alertas de nuevas ventas
ADMIN_EMAIL=admin@nave5barcelona.com

# Clave "service_role" de Supabase (Settings -> API Keys). El servidor la usa para saltarse
# las políticas de Row Level Security, ya que él mismo comprueba los permisos de admin.
# NUNCA la expongas en el cliente/navegador -- solo va en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Client ID de Google Cloud (Google Auth Platform > Clientes) para "Continuar con Google".
# Debe ser el MISMO valor que VITE_GOOGLE_CLIENT_ID en el frontend. Si se deja en blanco,
# el botón de Google queda desactivado en vez de fallar.
GOOGLE_CLIENT_ID=
