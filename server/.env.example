# server/.env.example

# Puerto del servidor local (por defecto 5000)
PORT=5000

# URL del proyecto de Supabase (ej: https://xxxxxxxxxxxxxx.supabase.co). OBLIGATORIA: sin ella
# el servidor no arranca (falla rápido, con un mensaje claro, en vez de arrancar a medias).
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública ("anon") de Supabase. El servidor YA NO la usa (ver SUPABASE_SERVICE_ROLE_KEY,
# más abajo en este archivo, que es la que necesita para funcionar); solo la usa
# server/src/seed.js, el script para poblar la base de datos de ejemplo.
SUPABASE_ANON_KEY=tu-clave-de-supabase

# Secreto para firmar los tokens de sesión (login/admin). Genera uno único por entorno, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# URL pública del frontend, se usa para volver desde el pago de Stripe
CLIENT_URL=http://localhost:5173

# Clave secreta de Stripe en modo TEST (Dashboard de Stripe > Desarrolladores > Claves de API). Empieza por sk_test_...
STRIPE_SECRET_KEY=

# Secreto de firma del webhook de Stripe (empieza por "whsec_..."). Stripe avisa a
# POST /api/stripe/webhook cuando se completa un pago, aunque el comprador cierre el
# navegador antes de volver a la web. Sin esta variable el webhook responde 503 y los
# pedidos solo se registran cuando el comprador llega a la página de éxito.
# - Producción/preview: Dashboard de Stripe > Desarrolladores > Webhooks > Añadir endpoint,
#   URL "https://<tu-api>/api/stripe/webhook", evento "checkout.session.completed", y copia
#   aquí el "Secreto de firma" que muestra Stripe. Usa la URL final: Stripe cuenta una
#   redirección (p. ej. de http a https o de un dominio a otro) como fallo del webhook.
# - Local: `stripe listen --forward-to localhost:5000/api/stripe/webhook` imprime un
#   "whsec_..." que sirve como valor.
# Formato de ejemplo (NO es un secreto real, no lo pegues tal cual):
#   STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# La línea de abajo se deja VACÍA a propósito: un valor de relleno cuenta como "configurado"
# y el webhook rechazaría todos los eventos (400) sin que se notara.
STRIPE_WEBHOOK_SECRET=

# Todos los correos (bienvenida, aviso de venta, confirmación al cliente) se envían con
# Resend (https://resend.com)
# 1) Crea una cuenta en Resend y genera una API key en el Dashboard > API Keys.
# 2) RESEND_API_KEY: la clave generada (empieza por "re_..."). Si se deja en blanco,
#    el sistema simula el envío con logs en consola en vez de fallar.
RESEND_API_KEY=

# Dirección remitente. Con el plan gratuito de Resend, sin un dominio propio verificado,
# SOLO puedes usar el dominio sandbox "onboarding@resend.dev" -- y ese dominio únicamente
# entrega correos a la dirección con la que verificaste tu cuenta de Resend. Si más adelante
# verificas un dominio propio (Dashboard > Domains), cambia esto por algo como
# "Nave 5 Barcelona <ventas@nave5barcelona.com>".
RESEND_FROM=Nave 5 Barcelona <onboarding@resend.dev>

# Email donde el administrador recibirá las alertas de nuevas ventas
ADMIN_EMAIL=admin@nave5barcelona.com

# Clave "service_role" de Supabase (Settings -> API Keys). El servidor la usa para saltarse
# las políticas de Row Level Security, ya que él mismo comprueba los permisos de admin.
# NUNCA la expongas en el cliente/navegador -- solo va en el servidor.
# OBLIGATORIA: sin ella el servidor no arranca (ver server/src/data/supabase.js). Ya no hay
# respaldo a la clave "anon" -- dejaba al servidor sujeto, en silencio, a las políticas de Row
# Level Security pensadas para el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Lista de orígenes adicionales permitidos por CORS, separados por comas, además de CLIENT_URL y
# de localhost:5173/5174 (desarrollo). Útil para un despliegue de vista previa de Vercel de una
# rama concreta, que tiene su propia URL distinta a CLIENT_URL. Deben ser orígenes EXACTOS (con
# protocolo, sin barra final): un comodín tipo "https://*.vercel.app" ya no se admite, porque
# cualquiera puede desplegar un proyecto propio en Vercel y su dominio también terminaría en
# ".vercel.app". Ejemplo con dos orígenes:
#   ALLOWED_ORIGINS=https://nave5-demo-git-mi-rama-mi-equipo.vercel.app,https://otro-dominio.com
ALLOWED_ORIGINS=

# Client ID de Google Cloud (Google Auth Platform > Clientes) para "Continuar con Google".
# Debe ser el MISMO valor que VITE_GOOGLE_CLIENT_ID en el frontend. Si se deja en blanco,
# el botón de Google queda desactivado en vez de fallar.
GOOGLE_CLIENT_ID=
