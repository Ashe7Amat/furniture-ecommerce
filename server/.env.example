# server/.env.example

# Puerto del servidor local (por defecto 5000)
PORT=5000

# URL del proyecto de Supabase (ej: https://xxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de servicio de Supabase o Anon Key (Anon Key suele bastar para inserciones básicas si no hay RLS estrictas)
SUPABASE_ANON_KEY=tu-clave-de-supabase

# Secreto para firmar los tokens de sesión (login/admin). Genera uno único por entorno, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# URL pública del frontend, se usa para volver desde el pago de Stripe
CLIENT_URL=http://localhost:5173

# Clave secreta de Stripe en modo TEST (Dashboard de Stripe > Desarrolladores > Claves de API). Empieza por sk_test_...
STRIPE_SECRET_KEY=

# Configuración de notificaciones por Correo (SMTP / Nodemailer)
# Si se dejan en blanco, el sistema guardará logs simulados en la terminal en lugar de fallar.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp@correo.com
SMTP_PASS=tu-contraseña-smtp

# Email donde el administrador recibirá las alertas de nuevas ventas
ADMIN_EMAIL=admin@nave5barcelona.com

# Clave "service_role" de Supabase (Settings -> API Keys). El servidor la usa para saltarse
# las políticas de Row Level Security, ya que él mismo comprueba los permisos de admin.
# NUNCA la expongas en el cliente/navegador -- solo va en el servidor.
SUPABASE_SERVICE_ROLE_KEY=
