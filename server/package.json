{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend for Catalogo Muebles",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
