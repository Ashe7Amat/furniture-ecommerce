    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "stripe": "^17.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-n": "^17.24.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
