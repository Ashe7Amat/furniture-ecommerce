# client/.env.example

# URL base de la API del servidor. En local: http://localhost:5000/api
# En producción: la URL pública donde despliegues el backend, ej: https://nave5-api.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Client ID de Google Cloud (Google Auth Platform > Clientes) para "Continuar con Google".
# Debe ser el MISMO valor que GOOGLE_CLIENT_ID en el backend. Si se deja en blanco, se
# muestra un botón desactivado en vez del login real.
VITE_GOOGLE_CLIENT_ID=

# Measurement ID de Google Analytics 4 (Admin > Flujos de datos > Web), con formato
# "G-XXXXXXXXXX". Solo se carga después de que el visitante acepta las cookies de
# analítica en el banner de consentimiento. Si se deja en blanco, no se carga GA4.
VITE_GA_MEASUREMENT_ID=

# Reservas por fechas (alquiler con calendario). Apagado si se deja en blanco: la web y el panel
# son los de siempre. Se enciende con el valor "true", a la par con RESERVAS_ACTIVAS del servidor
# y no antes de aplicar la migración R2 (docs/reservas-diseno.md, 9.1). Variable de compilación.
VITE_RESERVAS_ACTIVAS=

# Optimización WebP por lotes. Solo activar ('true') tras ejecutar 'npm run images:optimize' en server
# para generar las variantes .webp en el bucket de Supabase. Por defecto 'false' para servir <img> plano y evitar CLS.
VITE_WEBP_OPTIMIZADAS=false

