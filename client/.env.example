# client/.env.example

# URL del proyecto de Supabase (ej: https://xxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica-de-supabase

# URL base de la API del servidor. En local: http://localhost:5000/api
# En producción: la URL pública donde despliegues el backend, ej: https://nave5-api.vercel.app/api
VITE_API_URL=http://localhost:5000/api
